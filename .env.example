# Configuración del servidor
NODE_ENV=development
PORT=3000

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=foam_creations
DB_USER=postgres
DB_PASSWORD=tu_password

# JWT
JWT_SECRET=cambia_esto_por_una_clave_secreta_segura
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=http://localhost:3000

// # API TUS - Sincronización QR
TUS_API_URL=apiurl
TUS_APP_KEY=appkey
TUS_APP_SECRET=Appsecret
# osTicket (mesa de ayuda en red) - solo lectura, fuente del reporte de Moldes
OSTICKET_DB_HOST=172.16.101.107
OSTICKET_DB_PORT=3306
OSTICKET_DB_NAME=osticket
OSTICKET_DB_USER=powerbi
OSTICKET_DB_PASSWORD=

# SharePoint (Microsoft Graph) - Compound e Inyección se leen solos de ahí.
# App registrada en Entra ID de Finproject con Sites.Selected; ver DESPLIEGUE_SHAREPOINT.md
SP_TENANT_ID=
SP_CLIENT_ID=
SP_CLIENT_SECRET=
# Cada cuánto se revisa, y cuánto debe llevar quieto un archivo antes de leerlo
SP_SYNC_MINUTOS=20
SP_REPOSO_MINUTOS=10
# CAPEX: cada cuánto se revisa la carpeta del plan (se toma la Rev más alta)
CAPEX_SYNC_MINUTOS=20
# AIMS: cada cuánto se revisa la carpeta del libro de indicadores (rev más alta)
AIMS_SYNC_MINUTOS=20
